class Solution:
    def lengthOfLastWord(self, s):
        length = 0
        i = len(s) - 1

        # bỏ khoảng trắng cuối
        while i >= 0 and s[i] == ' ':
            i -= 1

        # đếm từ cuối
        while i >= 0 and s[i] != ' ':
            length += 1
            i -= 1

        return length
