class Solution:
    def rotate(self, matrix):
        n = len(matrix)

        # Bước 1: transpose
        for i in range(n):
            for j in range(i, n):
                matrix[i][j], matrix[j][i] = matrix[j][i], matrix[i][j]

        # Bước 2: reverse từng hàng
        for i in range(n):
            matrix[i].reverse()
