class Solution:
    def rotateRight(self, head, k):
        if not head or not head.next or k == 0:
            return head

        # 1. tính độ dài
        n = 1
        tail = head
        while tail.next:
            tail = tail.next
            n += 1

        # 2. tối ưu k
        k = k % n
        if k == 0:
            return head

        # 3. nối vòng
        tail.next = head

        # 4. tìm node mới
        steps = n - k
        new_tail = head
        for _ in range(steps - 1):
            new_tail = new_tail.next

        # 5. cắt
        new_head = new_tail.next
        new_tail.next = None

        return new_head
