class Solution:
    def generateTrees(self, n):
        if n == 0:
            return []

        def build(l, r):
            if l > r:
                return [None]

            trees = []
            for i in range(l, r+1):
                for left in build(l, i-1):
                    for right in build(i+1, r):
                        root = TreeNode(i)
                        root.left = left
                        root.right = right
                        trees.append(root)
            return trees

        return build(1, n)
