class Solution:
    def myAtoi(self, s):
        INT_MAX = 2**31 - 1
        INT_MIN = -2**31

        i = 0
        n = len(s)

        # 1. bỏ khoảng trắng
        while i < n and s[i] == ' ':
            i += 1

        # 2. dấu
        sign = 1
        if i < n and (s[i] == '+' or s[i] == '-'):
            if s[i] == '-':
                sign = -1
            i += 1

        # 3. đọc số
        res = 0
        while i < n and s[i].isdigit():
            digit = int(s[i])

            # 4. check overflow trước khi thêm
            if res > INT_MAX // 10 or (res == INT_MAX // 10 and digit > 7):
                return INT_MAX if sign == 1 else INT_MIN

            res = res * 10 + digit
            i += 1

        return sign * res
