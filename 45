class Solution:
    def isMatch(self, s, p):
        i = j = 0
        star = -1
        match = 0

        while i < len(s):
            # match hoặc '?'
            if j < len(p) and (p[j] == s[i] or p[j] == '?'):
                i += 1
                j += 1

            # gặp '*'
            elif j < len(p) and p[j] == '*':
                star = j
                match = i
                j += 1

            # không match nhưng đã có '*'
            elif star != -1:
                j = star + 1
                match += 1
                i = match

            # không match và không có '*'
            else:
                return False

        # kiểm tra phần còn lại của p
        while j < len(p) and p[j] == '*':
            j += 1

        return j == len(p)
