class Solution:
    def isMatch(self, s, p):
        m = len(s)
        n = len(p)

        # dp[i][j]: s[0:i] match p[0:j]
        dp = [[False] * (n + 1) for _ in range(m + 1)]
        dp[0][0] = True

        # xử lý trường hợp pattern như a*, a*b*, ...
        for j in range(2, n + 1):
            if p[j - 1] == '*':
                dp[0][j] = dp[0][j - 2]

        for i in range(1, m + 1):
            for j in range(1, n + 1):

                # nếu ký tự giống nhau hoặc p[j-1] là '.'
                if p[j - 1] == s[i - 1] or p[j - 1] == '.':
                    dp[i][j] = dp[i - 1][j - 1]

                # nếu là '*'
                elif p[j - 1] == '*':
                    # trường hợp dùng 0 lần
                    dp[i][j] = dp[i][j - 2]

                    # trường hợp dùng >= 1 lần
                    if p[j - 2] == s[i - 1] or p[j - 2] == '.':
                        dp[i][j] = dp[i][j] or dp[i - 1][j]

        return dp[m][n]
