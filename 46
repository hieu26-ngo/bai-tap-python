class Solution:
    def permute(self, nums):
        res = []

        def backtrack(path, used):
            # đủ độ dài → thêm vào kết quả
            if len(path) == len(nums):
                res.append(path[:])
                return

            for i in range(len(nums)):
                if used[i]:
                    continue

                # chọn
                used[i] = True
                path.append(nums[i])

                # đệ quy
                backtrack(path, used)

                # quay lui
                path.pop()
                used[i] = False

        backtrack([], [False] * len(nums))
        return res
