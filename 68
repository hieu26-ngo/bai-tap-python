class Solution:
    def fullJustify(self, words, maxWidth):
        res = []
        i = 0

        while i < len(words):
            # 1. gom từ
            line = []
            length = 0

            while i < len(words) and length + len(line) + len(words[i]) <= maxWidth:
                line.append(words[i])
                length += len(words[i])
                i += 1

            # 2. xử lý dòng
            spaces = maxWidth - length

            # dòng cuối hoặc 1 từ
            if i == len(words) or len(line) == 1:
                s = ' '.join(line)
                s += ' ' * (maxWidth - len(s))
                res.append(s)
            else:
                slots = len(line) - 1
                space_each = spaces // slots
                extra = spaces % slots

                s = ""
                for j in range(slots):
                    s += line[j]
                    s += ' ' * (space_each + (1 if j < extra else 0))
                s += line[-1]

                res.append(s)

        return res
